# Supabase credentials (optional — app works offline without these)
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe credentials (optional — upgrade flow falls back to demo mode)
# Get these from your Stripe dashboard → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
VITE_STRIPE_PRICE_MONTHLY=price_...
VITE_STRIPE_PRICE_YEARLY=price_...
